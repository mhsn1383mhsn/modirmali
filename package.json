{
  "name": "finance-android",
  "version": "3.1.0",
  "private": true,
  "description": "مدیریت مالی — اپ اندروید با Capacitor",
  "scripts": {
    "android:add": "npm run vendor && cap add android && node scripts/patch-android.js && capacitor-assets generate --android && cap sync android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "test": "node tests/selftest.mjs",
    "vendor": "node scripts/copy-vendor.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@capgo/capacitor-native-biometric": "^6.0.0",
    "@hugotomazi/capacitor-navigation-bar": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
